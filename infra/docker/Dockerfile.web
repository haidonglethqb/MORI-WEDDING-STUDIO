# ── Stage 1: base ──────────────────────────────────────────────────────────
FROM node:24-alpine AS base
RUN corepack enable && corepack prepare pnpm@12.16.1 --activate
WORKDIR /app

# ── Stage 2: workspace deps ─────────────────────────────────────────────────
FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/config/package.json packages/config/
COPY packages/contracts/package.json packages/contracts/
COPY packages/database/package.json packages/database/
COPY packages/domain/package.json packages/domain/
COPY packages/invitation-renderer/package.json packages/invitation-renderer/
COPY packages/ui/package.json packages/ui/
COPY packages/api-client/package.json packages/api-client/
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
COPY apps/web/package.json apps/web/

RUN pnpm install --frozen-lockfile

# ── Stage 3: build ──────────────────────────────────────────────────────────
FROM deps AS builder
COPY . .
# Build shared packages first
RUN pnpm --filter @mori/contracts build
RUN pnpm --filter @mori/domain build
RUN pnpm --filter @mori/invitation-renderer build
# Build Next.js app (standalone output)
# API_INTERNAL_ORIGIN is a runtime env var, not a build-time one
RUN pnpm --filter @mori/web build

# ── Stage 4: runtime ────────────────────────────────────────────────────────
FROM node:24-alpine AS runtime

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

WORKDIR /app

# Next.js standalone server
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
# Static assets (must be at .next/static relative to the standalone server)
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static apps/web/.next/static/
# Serve the self-hosted fonts and other public assets with the standalone server.
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public apps/web/public/

USER nextjs

EXPOSE 3000

ENV PORT=3000 \
    NODE_ENV=production \
    HOSTNAME=0.0.0.0

CMD ["node", "apps/web/server.js"]
