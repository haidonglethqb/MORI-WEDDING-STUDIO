{
  "name": "@mori/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test:unit": "vitest run --passWithNoTests",
    "db:seed:dev": "node --import tsx/esm scripts/seed-dev.ts",
    "api:generate": "node --import tsx/esm scripts/generate-openapi.ts --write",
    "api:check-drift": "node --import tsx/esm scripts/generate-openapi.ts --check"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@mori/config": "workspace:*",
    "@mori/contracts": "workspace:*",
    "@mori/database": "workspace:*",
    "@mori/domain": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@node-rs/argon2": "2.0.2",
    "nodemailer": "^10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.3.2",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.21",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/nodemailer": "^8.0.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
