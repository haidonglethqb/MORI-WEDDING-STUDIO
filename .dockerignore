# VCS
.git
.gitignore

# Dependencies (will be installed inside container)
node_modules
**/node_modules

# Build outputs (re-built inside container)
dist
**/.next
**/*.tsbuildinfo

# Dev / local config
.env
.env.*
!.env.example
.nvmrc
.vscode
.idea

# Docs / plans (not needed at runtime)
docs/adr
docs/runbooks
plans

# Test artifacts
coverage
*.test.ts
*.spec.ts
tests/

# Misc
.DS_Store
*.log
