# ─── Environment ───────────────────────────────────────────────────────────────
APP_ENV=development

# ─── Database ──────────────────────────────────────────────────────────────────
# Either set DATABASE_URL directly (dev) or DATABASE_URL_FILE (prod secret mount)
DATABASE_URL=postgresql://mori:mori_secret@localhost:5432/mori_db
# DATABASE_URL_FILE=/run/secrets/database_url

# ─── API ───────────────────────────────────────────────────────────────────────
PORT=4000
# Internal address the web server uses to call the API (never NEXT_PUBLIC_*)
API_INTERNAL_ORIGIN=http://localhost:4000

# ─── Origins ───────────────────────────────────────────────────────────────────
PUBLIC_APP_ORIGIN=http://localhost:3000
PUBLIC_INVITE_ORIGIN=http://localhost:3000

# ─── AI Assistant (Codex / Groq Multi-Model Gateway) ───────────────────────────
CODEX_API_KEY=your_codex_api_key_here
CODEX_BASE_URL=https://api.modelapi.vn/v1
GROQ_API_KEY=your_groq_api_key_here
