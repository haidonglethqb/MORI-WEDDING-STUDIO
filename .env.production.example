# Production Environment Variables for MORI Wedding Studio
# Placed at /opt/mori/.env on the VPS

# Application Environment
APP_ENV=production
NODE_ENV=production

# Database Credentials
POSTGRES_USER=mori
POSTGRES_DB=mori_db
POSTGRES_PASSWORD=replace_with_strong_password_here

# Container Registry
IMAGE_REGISTRY=ghcr.io
IMAGE_REPO=haidonglethqb
IMAGE_TAG=latest

# Public Access Domains / Origins
PUBLIC_APP_ORIGIN=https://moriwedding.xyz
PUBLIC_INVITE_ORIGIN=https://moriwedding.xyz
API_INTERNAL_ORIGIN=http://api:4000

# OxMail SMTP. Set the real mailbox password in GitHub Actions secret SMTP_PASSWORD.
SMTP_HOST=mail.moriwedding.xyz
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mori@moriwedding.xyz
SMTP_PASSWORD=
SMTP_FROM="MORI Wedding Studio <mori@moriwedding.xyz>"
