# Production Environment Variables for MORI Wedding Studio
# Placed at /opt/mori/.env on the VPS

# Application Environment
APP_ENV=production
NODE_ENV=production

# Database Credentials
POSTGRES_USER=mori
POSTGRES_DB=mori_db
POSTGRES_PASSWORD=replace_with_strong_password_here

# Container Registry
IMAGE_REGISTRY=ghcr.io
IMAGE_REPO=haidonglethqb
IMAGE_TAG=latest

# Public Access Domains / Origins
PUBLIC_APP_ORIGIN=http://43.240.117.146
PUBLIC_INVITE_ORIGIN=http://43.240.117.146
API_INTERNAL_ORIGIN=http://api:4000
